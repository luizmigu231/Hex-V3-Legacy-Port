42 attribute vec2 aPath;
uniform vec4 uPath[
3346 ];
uniform vec4 uPathInfo;
uniform mat3 uField;
uniform vec3 uPivot;
uniform vec3 uShift;
uniform vec4 uLens;
// x and y take the game's screen into the picture, z and w are where its top and left edges
// land: a whole screen puts them at one and minus one, a piece of one puts them further out.
uniform vec4 uScreen;
uniform vec2 uLayer;
uniform vec3 uLightAt;
uniform float uHomo;
uniform float nfTime;
uniform float nfBeat;
uniform vec2 nfSize;
varying vec2 vUV;
varying vec4 vColor;
varying float vDown;
varying vec3 vWorld;
varying vec3 vNormal;
varying vec3 vLocal;
varying float vWash;

vec4 pathAt(float t, float last) {
    float i = floor(t);
    float f = t - i;

    vec4 p0 = uPath[int(clamp(i - 1.0, 0.0, last))];
    vec4 p1 = uPath[int(clamp(i, 0.0, last))];
    vec4 p2 = uPath[int(clamp(i + 1.0, 0.0, last))];
    vec4 p3 = uPath[int(clamp(i + 2.0, 0.0, last))];

    vec3 a = 2.0 * p1.xyz;
    vec3 b = p2.xyz - p0.xyz;
    vec3 c = 2.0 * p0.xyz - 5.0 * p1.xyz + 4.0 * p2.xyz - p3.xyz;
    vec3 d = 3.0 * p1.xyz - p0.xyz - 3.0 * p2.xyz + p3.xyz;

    vec3 here = 0.5 * (a + b * f + c * f * f + d * f * f * f);

    return vec4(here, p1.w + (p2.w - p1.w) * f);
}

float nfPathLast() {
    return uPathInfo.x - 1.0;
}

float nfPathT() {
    return aPath.x / max(uPathInfo.z - 1.0, 1.0) * nfPathLast();
}

vec3 nfWorld() {
    float last = nfPathLast();
    float t = nfPathT();

    vec4 here = pathAt(t, last);

    float reach = 0.35;
    vec3 ahead = pathAt(min(t + reach, last), last).xyz;
    vec3 back = pathAt(max(t - reach, 0.0), last).xyz;

    vec2 run = ahead.xy - back.xy;
    float len = length(run);
    vec2 dir = len > 0.0001 ? run / len : vec2(0.0, 1.0);
    vec2 across = vec2(-dir.y, dir.x);

    return here.xyz + vec3(across * uPathInfo.y * aPath.y, 0.0);
}

vec3 nfNormal() {
    return vec3(0.0, 0.0, 1.0);
}

vec2 nfUV() {
    return vec2(uPathInfo.w, uPathInfo.w);
}

vec4 nfTint() {
    return vec4(1.0, 1.0, 1.0, pathAt(nfPathT(), nfPathLast()).w);
}

void nfPass(vec3 world) {
    vUV = nfUV();
    vDown = 0.5;
    vWorld = world + uLightAt;
    vNormal = nfNormal();
    vLocal = vec3(0.0, 0.0, 0.0);
    vColor = nfTint();
    vWash = 0.0;
}

vec2 nfScreenOf(vec3 world) {
    vec3 turned = uField * (world - uPivot) + uShift;
    float w = uLens.x / max(uLens.x - turned.z, 1.0);
    return vec2(uLens.y, uLens.z) + turned.xy * w;
}

vec4 nfProject(vec3 world) {
    vec3 turned = uField * (world - uPivot) + uShift;

    float raw = uLens.x - turned.z;
    float away = max(raw, 1.0);
    float w = uLens.x / away;

    vec2 screen = vec2(uLens.y, uLens.z) + turned.xy * w;

    float depth = clamp(-turned.z / uLens.w, -1.0, 1.0) * uLayer.y * 0.98 + uLayer.x;

    float flatX = screen.x * uScreen.x + uScreen.w;
    float flatY = screen.y * uScreen.y + uScreen.z;

    float far = raw / uLens.x;
    vec4 kept = vec4((uLens.y * uScreen.x + uScreen.w) * far + turned.x * uScreen.x,
                     (uLens.z * uScreen.y + uScreen.z) * far + turned.y * uScreen.y,
                     depth * far, far);

    return uHomo > 0.5 ? kept : vec4(flatX, flatY, depth, 1.0);
}

vec4 nfVertex() {
    vec3 world = nfWorld();
    nfPass(world);
    return nfProject(world);
}

3405 #ifdef GL_ES
precision highp float;
#endif
varying vec2 vUV;
varying vec4 vColor;
varying float vDown;
varying vec3 vWorld;
varying vec3 vNormal;
varying vec3 vLocal;
varying float vWash;
uniform sampler2D uTexture;
uniform sampler2D uCut;
uniform float uHasCut;
uniform float uGradient;
uniform vec4 uLight;
uniform vec4 uLamp[4];
uniform vec4 uLampHue[4];
uniform float uLightMix;
uniform float uLightLow;
uniform vec3 uEye;
uniform vec3 uLightAt;
uniform float uSky;
uniform vec4 uRound;
uniform float nfTime;
uniform float nfBeat;
uniform vec2 nfSize;

vec2 allRound(vec3 d) {
    return vec2(atan(d.z, d.x) * 0.15915494 + 0.5, acos(clamp(-d.y, -1.0, 1.0)) * 0.31830989);
}

// a round picture is read at its middle
vec4 roundPick(sampler2D tex, vec3 dir, vec4 spec) {
    return texture2D(tex, spec.zw);
}

vec2 nfUV() {
    return (uSky > 0.5 && uSky < 1.5) ? allRound(normalize(vLocal)) : vUV;
}

vec4 nfSampleAt(vec2 uv) {
    return texture2D(uTexture, uv);
}

vec4 nfSample() {
    return (uSky > 1.5 && uSky < 2.5) ? roundPick(uTexture, normalize(vLocal), uRound) : texture2D(uTexture, nfUV());
}

// a material may keep what can be seen through it in a picture of its own. where it does,
// that one has the last word and the diffuse picture only says what color it is
float nfCut(vec4 texel) {
    return uHasCut > 0.5 ? texture2D(uCut, nfUV()).a : texel.a;
}

// fadeTop: a band travelling down the art, a hundred gone from the top, two hundred back again.
float nfFade() {
    if (uGradient == 0.0) return vColor.a;

    float turn = mod(uGradient * 0.5, 1.0) * 2.0;
    float down = clamp(vDown, 0.0, 1.0);

    float much = turn < 1.0 ? (down - (turn * 2.0 - 1.0)) : (turn * 2.0 - 2.0 - down);

    return vColor.a * clamp(much, 0.0, 1.0);
}

float nfAlpha(vec4 texel) {
    return nfCut(texel) * nfFade();
}

// the normal is turned to the eye so a note's back is lit like its front
vec3 nfLook() {
    float reach = length(vNormal);
    vec3 look = reach > 0.0001 ? vNormal / reach : vec3(0.0, 0.0, 1.0);

    if (dot(look, uEye - vWorld + uLightAt) < 0.0) look = -look;

    return look;
}

vec3 nfLitWith(vec3 look) {
    if (uSky > 0.5 || uLightMix <= 0.0) return vColor.rgb;

    float lit = uLight.w + (1.0 - uLight.w) * max(dot(look, uLight.xyz), 0.0);

    lit = max(lit, uLightLow);

    vec3 glow = vec3(0.0);
    for (int i = 0; i < 4; i++) {
        float range = uLamp[i].w;
        if (range <= 0.0001) continue;

        vec3 toward = uLamp[i].xyz - vWorld;
        float gap = length(toward);
        float fall = max(0.0, 1.0 - gap / max(range, 0.0001)) * step(0.0001, range);
        float face = max(dot(look, toward / max(gap, 0.0001)), 0.0);
        glow += uLampHue[i].rgb * uLampHue[i].w * fall * fall * face;
    }

    return uSky > 0.5 ? vColor.rgb : vColor.rgb * (mix(1.0, lit, uLightMix) + glow * uLightMix);
}

vec3 nfLit() {
    return nfLitWith(nfLook());
}

vec4 nfShadeWith(vec4 texel, vec3 look) {
    float carved = nfCut(texel);
    float fade = nfFade();
    if (carved * fade < 0.04) discard;

    vec3 base = mix(texel.rgb, vec3(1.0), vWash);

    return vec4(base * nfLitWith(look), carved) * fade;
}

vec4 nfShade(vec4 texel) {
    return nfShadeWith(texel, nfLook());
}

vec4 nfColor() {
    return nfShade(nfSample());
}

471 attribute vec2 aSpot;
uniform float nfTime;
uniform float nfBeat;
uniform vec2 nfSize;
// Which piece of the picture is read, as a corner and a size in its own coordinates. The whole
// of it is 0, 0, 1, 1, which is what everything but a piece being copied out asks for.
uniform vec4 uPatch;
varying vec2 vUV;

vec2 nfUV() {
    return uPatch.xy + aSpot * uPatch.zw;
}

vec4 nfVertex() {
    vUV = nfUV();
    return vec4(aSpot * 2.0 - 1.0, 0.0, 1.0);
}

