    uniform float uTop;
    uniform float uBottom;
    uniform float uRight;

    void main() {
        vec4 color = flixel_texture2D(bitmap, openfl_TextureCoordv);
        if (openfl_TextureCoordv.y >= uTop && openfl_TextureCoordv.y <= uBottom && openfl_TextureCoordv.x <= uRight)
